        "repo": {
          "url": "https://download.docker.com/linux/ubuntu",
          "components": "stable",
          "arch": "amd64",
          "codename": "auto-ubuntu-equivalent",
          "key_url": "https://download.docker.com/linux/ubuntu/gpg"
        }
      },
      "note": "arch install path not yet modeled here, add when ported"
    },
    { "id": "docker-compose", "category": "dev-tool",
      "common": {
        "type": "binary-release",
        "source": { "kind": "github-latest-release", "repo": "docker/compose", "asset_pattern": "docker-compose-linux-{arch}" },
        "install_path": "/usr/local/bin/docker-compose",
        "mode": "0755"
      }
    },

    { "id": "nvidia-driver", "category": "driver",
      "debian": {
        "type": "apt-repo",
        "package": { "resolver": "apt-cache-pattern", "pattern": "^nvidia-driver-[0-9]+$", "pick": "latest" },
