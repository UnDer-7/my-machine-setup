    { "id": "jetbrains-toolbox", "category": "desktop",
      "arch": { "type": "aur", "package": "jetbrains-toolbox" },
      "debian": {
        "type": "binary-release",
        "source": {
          "kind": "json-api",
          "url": "https://data.services.jetbrains.com/products/releases?code=TBA&latest=true&type=release",
          "json_path": "TBA[0].downloads.linux.link"
        },
        "archive": "tar.gz",
        "strip_components": 1,
        "install_path": "~/.local/share/JetBrains/Toolbox",
        "executable": "bin/jetbrains-toolbox",
        "symlink": "~/.local/bin/jetbrains-toolbox",
        "desktop_entry": { "name": "JetBrains Toolbox", "icon": "bin/toolbox-tray-color.png" }
      }
    },
    { "id": "postman", "category": "desktop",
      "debian": {
        "type": "binary-release",
        "source": { "kind": "static-url", "url": "https://dl.pstmn.io/download/latest/linux_64" },
        "archive": "tar.gz",
        "install_path": "~/.local/share/Postman",
        "executable": "app/Postman",
        "desktop_entry": { "name": "Postman", "icon": "app/icons/icon_128x128.png" }
      }
    },
    { "id": "mockoon", "category": "desktop",
      "arch": { "type": "aur", "package": "mockoon-bin" },
      "debian": {
        "type": "binary-release",
        "source": { "kind": "github-latest-release", "repo": "mockoon/mockoon", "asset_pattern": "mockoon-{version}.amd64.deb" },
